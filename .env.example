# Discord Developer Portal > Your Application > Bot
# Keep the real token private. Never commit your .env file.
DISCORD_BOT_TOKEN=replace_with_your_discord_bot_token

# Google AI Studio (Gemini API) OpenAI-compatible endpoint.
AI_API_KEY=replace_with_your_gemini_api_key
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.8-flash

LOG_LEVEL=INFO
