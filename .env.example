# Discord Developer Portal > Your Application > Bot > Reset Token
# Keep the real token private. Never commit your .env file.
DISCORD_BOT_TOKEN=replace_with_your_discord_bot_token

# OpenAI-compatible AI provider settings.
# Example Groq-compatible endpoint: https://api.groq.com/openai/v1
# Leave AI_BASE_URL empty if your provider uses the OpenAI default endpoint.
AI_API_KEY=replace_with_your_ai_provider_key
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=replace_with_a_model_supported_by_your_provider

LOG_LEVEL=INFO
